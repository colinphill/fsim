# Writes Tcl's script library and modules as a C++ byte array, so the embedded interpreter
# mounts it with zipfs instead of finding init.tcl on disk. The fetched tclsh
# writes the archive: zipfs reads its own archives, but not the data
# descriptors CMake's zip writer emits.

foreach(required IN ITEMS TCL_INSTALL_DIR TCL_LIBRARY_VERSION WORK_DIR OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()

set(library_dir "${TCL_INSTALL_DIR}/lib/tcl${TCL_LIBRARY_VERSION}")
if(NOT EXISTS "${library_dir}/init.tcl")
  message(FATAL_ERROR "Tcl script library is incomplete: ${library_dir}")
endif()
file(GLOB tclsh_candidates "${TCL_INSTALL_DIR}/bin/tclsh*")
list(FILTER tclsh_candidates EXCLUDE REGEX "\\.(pdb|ilk|manifest)$")
list(SORT tclsh_candidates)
list(LENGTH tclsh_candidates tclsh_count)
if(tclsh_count EQUAL 0)
  message(FATAL_ERROR "the fetched Tcl build installed no tclsh")
endif()
list(GET tclsh_candidates 0 tclsh)

# The archive root mirrors Tcl's lib directory: the script library and,
# beside it, the tcl9/9.0 modules (msgcat for clock, http, ...) that Tcl's
# module path finds next to [info library].
string(REGEX MATCH "^[0-9]+" tcl_major "${TCL_LIBRARY_VERSION}")
set(module_dir "${TCL_INSTALL_DIR}/lib/tcl${tcl_major}")
set(stage "${WORK_DIR}/lib")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${library_dir}" DESTINATION "${stage}")
if(EXISTS "${module_dir}")
  file(COPY "${module_dir}" DESTINATION "${stage}")
endif()
set(archive "${WORK_DIR}/tcl-library.zip")
file(REMOVE "${archive}")
file(WRITE "${WORK_DIR}/mkzip.tcl"
  "lassign \$argv archive directory\n"
  "zipfs mkzip \$archive \$directory \$directory\n")
execute_process(
  COMMAND "${tclsh}" "${WORK_DIR}/mkzip.tcl" "${archive}" "${stage}"
  RESULT_VARIABLE result
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error
)
if(NOT result EQUAL 0 OR NOT EXISTS "${archive}")
  message(FATAL_ERROR
    "zipfs mkzip failed with ${result}\n${output}${error}")
endif()

file(READ "${archive}" bytes HEX)
string(REPEAT "[0-9a-f]" 32 line_pattern)
string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/EmbedTclLibrary.cmake from Tcl's script library.\n"
  "#include <cstddef>\n\n"
  "namespace fsim::app {\n\n"
  "extern const unsigned char embedded_tcl_library[];\n"
  "extern const std::size_t embedded_tcl_library_size;\n\n"
  "const unsigned char embedded_tcl_library[] = {\n"
  "${bytes}\n"
  "};\n"
  "const std::size_t embedded_tcl_library_size = sizeof(embedded_tcl_library);\n\n"
  "} // namespace fsim::app\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
