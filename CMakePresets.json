{
  "version": 6,
  "vendor": {
    "fsim.dev/spdx": "SPDX-License-Identifier: Apache-2.0"
  },
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FSIM_BUILD_TESTS": "ON",
        "FSIM_LLVM_MODE": "AUTO"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "FSIM_BUILD_TESTS": "ON",
        "FSIM_LLVM_MODE": "AUTO"
      }
    },
    {
      "name": "windows-llvm-mingw",
      "displayName": "Windows LLVM-MinGW",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-llvm-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/clang++.exe",
        "CMAKE_RC_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/llvm-windres.exe",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "FSIM_BUILD_TESTS": "ON",
        "FSIM_TCL_MODE": "ON",
        "FSIM_LLVM_MODE": "ON"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux Clang 22",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FSIM_BUILD_TESTS": "ON",
        "FSIM_LLVM_MODE": "OFF",
        "FSIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-linux-release",
      "displayName": "CI Linux Clang 22 Release",
      "inherits": "ci-linux",
      "binaryDir": "${sourceDir}/build/ci-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-sanitizers",
      "displayName": "Scheduled local Linux ASan and UBSan",
      "inherits": "ci-linux",
      "binaryDir": "${sourceDir}/build/ci-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "ci-fuzz",
      "displayName": "CI Clang frontend fuzz smoke",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FSIM_BUILD_TESTS": "OFF",
        "FSIM_BUILD_FUZZERS": "ON",
        "FSIM_LLVM_MODE": "OFF",
        "FSIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows LLVM-MinGW",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/clang++.exe",
        "CMAKE_RC_COMPILER": "$env{LLVM_MINGW_ROOT}/bin/llvm-windres.exe",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "FSIM_BUILD_TESTS": "ON",
        "FSIM_TCL_MODE": "ON",
        "FSIM_LLVM_MODE": "OFF",
        "FSIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows-release",
      "displayName": "CI Windows LLVM-MinGW Release",
      "inherits": "ci-windows",
      "binaryDir": "${sourceDir}/build/ci-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "windows-llvm-mingw",
      "configurePreset": "windows-llvm-mingw"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "ci-linux-release",
      "configurePreset": "ci-linux-release"
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers"
    },
    {
      "name": "ci-fuzz",
      "configurePreset": "ci-fuzz",
      "targets": [
        "fsim_frontend_fuzz"
      ]
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-windows-release",
      "configurePreset": "ci-windows-release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-llvm-mingw",
      "configurePreset": "windows-llvm-mingw",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux-release",
      "configurePreset": "ci-linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows-release",
      "configurePreset": "ci-windows-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
