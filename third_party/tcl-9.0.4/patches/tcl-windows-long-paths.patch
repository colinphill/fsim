+/*
+ *---------------------------------------------------------------------------
+ *
+ * TclWinExtendNativePath --
+ *
+ *	Rewrite the absolute native path held in dsPtr (a drive or UNC path
+ *	with either separator) in extended-length form. This happens when the
+ *	path is too long for ordinary Win32 path handling, or always when
+ *	requested for a directory traversal root whose descendants may be
+ *	long.
+ *
+ * Results:
+ *	None.
+ *
+ * Side effects:
+ *	The contents of dsPtr may change.
+ *
+ *---------------------------------------------------------------------------
+ */
+
+void
+TclWinExtendNativePath(
+    Tcl_DString *dsPtr,
+    int always)
+{
+    const WCHAR *path = (const WCHAR *) Tcl_DStringValue(dsPtr);
+    size_t length = Tcl_DStringLength(dsPtr) / sizeof(WCHAR);
+    size_t skip, prefix, count, i;
+    const WCHAR *extended;
+    Tcl_DString copy;
+    WCHAR *out;
+
+    if (!always && length <= MAX_PATH - 12) {
+	return;
+    }
+    if (length >= 3
+	    && ((path[0] >= 'A' && path[0] <= 'Z')
+		|| (path[0] >= 'a' && path[0] <= 'z'))
+	    && path[1] == ':' && (path[2] == '\\' || path[2] == '/')) {
+	skip = 0;
+	extended = L"\\\\?\\";
+	prefix = 4;
+    } else if (length >= 3 && (path[0] == '\\' || path[0] == '/')
+	    && (path[1] == '\\' || path[1] == '/')
+	    && path[2] != '?' && path[2] != '.') {
+	skip = 2;
+	extended = L"\\\\?\\UNC\\";
+	prefix = 8;
+    } else {
+	return;
+    }
+
+    count = prefix + length - skip;
+    Tcl_DStringInit(&copy);
+    Tcl_DStringAppend(&copy, (const char *) path, length * sizeof(WCHAR));
+    path = (const WCHAR *) Tcl_DStringValue(&copy);
+    Tcl_DStringSetLength(dsPtr, (count + 1) * sizeof(WCHAR));
+    out = (WCHAR *) Tcl_DStringValue(dsPtr);
+    memcpy(out, extended, prefix * sizeof(WCHAR));
+    for (i = skip; i < length; i++) {
+	out[prefix + i - skip] = (path[i] == '/') ? '\\' : path[i];
+    }
+    out[count] = 0;
+    Tcl_DStringSetLength(dsPtr, count * sizeof(WCHAR));
+    Tcl_DStringFree(&copy);
+}
 
