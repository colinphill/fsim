+/*
+ *---------------------------------------------------------------------------
+ *
+ * NativeErrorPath --
+ *
+ *	Fill errorPtr with the UTF-8 name of a native path for error
+ *	reporting. An extended-length path is reported in the ordinary
+ *	forward-slash spelling of the normalized path it came from.
+ *
+ *---------------------------------------------------------------------------
+ */
+
+static void
+NativeErrorPath(
+    const WCHAR *nativePath,
+    Tcl_DString *errorPtr)
+{
+    int extended = 1;
+    char *p;
+
+    Tcl_DStringInit(errorPtr);
+    if (wcsncmp(nativePath, L"\\\\?\\UNC\\", 8) == 0) {
+	TclDStringAppendLiteral(errorPtr, "//");
+	nativePath += 8;
+    } else if (wcsncmp(nativePath, L"\\\\?\\", 4) == 0) {
+	nativePath += 4;
+    } else {
+	extended = 0;
+    }
+    Tcl_WCharToUtfDString(nativePath, TCL_INDEX_NONE, errorPtr);
+    if (extended) {
+	for (p = Tcl_DStringValue(errorPtr); *p != '\0'; p++) {
+	    if (*p == '\\') {
+		*p = '/';
+	    }
+	}
+    }
+}
