// SPDX-License-Identifier: Apache-2.0
(DELAYFILE
  (SDFVERSION "4.0")
  (DESIGN "four/top")
  (DATE "2026-08-13")
  (VENDOR "fsim clean-room corpus")
  (PROGRAM "fsim")
  (VERSION "1")
  (DIVIDER /)
  (VOLTAGE 0.90:1.00:1.10)
  (PROCESS "typical")
  (TEMPERATURE -40:25:125)
  (TIMESCALE 100 fs)
  (CELL
    (CELLTYPE "top")
    (INSTANCE top)
    (DELAY
      (PATHPULSE A Z (1) (2))
      (PATHPULSEPERCENT (10) (20))
      (ABSOLUTE
        (IOPATH (posedge A) Z (RETAIN (0.01)) (1:2:3) ())
        (COND "enabled" (EN == 1) (IOPATH A Z (2)))
        (CONDELSE (IOPATH A Z (3)))
        (INTERCONNECT A NET (1))
        (NETDELAY NET (1))
        (PORT Z (1) (2))
        (DEVICE Z (1))
        (MIPD A (1)))
      (INCREMENT (IOPATH CLK Z (0.1))))
    (TIMINGCHECK
      (SETUP D (01 CLK) (1))
      (HOLD (COND EN D) CLK (1))
      (SETUPHOLD D CLK (1) (2) (SCOND EN) (CCOND EN))
      (RECREM RN CLK (1) (2))
      (BIDIRECTSKEW A B (1) (2))
      (NEGATIVE (HOLD D CLK (1))))
    (TIMINGENV
      (PATHCONSTRAINT A Z (NAME "main") (1))
      (PERIODCONSTRAINT CLK (10))
      (SUM (A Z) (B Y) (1))
      (DIFF (A Z) (B Y) (1))
      (ARRIVAL A (1))
      (DEPARTURE Z (2))
      (SLACK D (3))
      (WAVEFORM CLK (1) (2))
      (EXCEPTION top/u1))
    (LABEL (NAME "mode" (1)) (user_delay (2))))
  (CELL (CELLTYPE "gate") (INSTANCE *)
    (DELAY (ABSOLUTE (IOPATH A Z (1)))))
  (CELL (CELLTYPE "top") (INSTANCE)
    (DELAY (ABSOLUTE (DEVICE (1))))))
