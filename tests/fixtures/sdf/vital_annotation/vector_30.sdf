// SPDX-License-Identifier: Apache-2.0
// Bus ports with index and range (IEEE 1076.4-2000 5.2.7.3.3) and RETAIN
// delays (5.2.6, Table 2).
(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "tb_vector")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "vvec") (INSTANCE tb_vector.v1)
    (DELAY (ABSOLUTE
      (IOPATH A[0] Y[1] (10:10:10) (20:20:20))
      (IOPATH A[1] Y[2] (30:30:30) (40:40:40))
      (IOPATH A[0:1] Z[1:2] (7:7:7) (8:8:8))
      (IOPATH DATAIN[0] DATAOUT[1] (10:10:10) (20:20:20))
      (IOPATH DATAIN[3] DATAOUT[4] (30:30:30) (40:40:40))
      (PORT A[1] (1:1:1) (2:2:2))
      (PORT A[0] (3:3:3) (4:4:4)))))
  (CELL (CELLTYPE "vretain") (INSTANCE tb_vector.r1)
    (DELAY (ABSOLUTE
      (IOPATH r1 y (RETAIN (1:1:1)) (5:5:5))
      (IOPATH r2 y (RETAIN (1:1:1) (2:2:2)) (5:5:5) (6:6:6))
      (IOPATH r3 y (RETAIN (1:1:1) (2:2:2) (3:3:3)) (4:4:4) (5:5:5) (6:6:6))
      (IOPATH r4 y (RETAIN (1:1:1)) (4:4:4) (5:5:5) (6:6:6)))))
)
