// SPDX-License-Identifier: Apache-2.0
// Three retain values need VitalDelayType01ZX, and tpd_r1_y is a
// VitalDelayType01Z: an error (IEEE 1076.4-2000 5.2.6).
(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "tb_vector")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "vretain") (INSTANCE tb_vector.r1)
    (DELAY (ABSOLUTE
      (IOPATH r1 y (RETAIN (1:1:1) (2:2:2) (3:3:3)) (4:4:4) (5:5:5) (6:6:6))))))
