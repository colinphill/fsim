// SPDX-License-Identifier: Apache-2.0
// Every construct of the VITAL SDF map (IEEE 1076.4-2000 5.2.7) on one cell.
(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "tb_names")
  (TIMESCALE 1ns)
  (CELL (CELLTYPE "vnames") (INSTANCE tb_names.n1)
    (DELAY (ABSOLUTE
      (IOPATH a y (1:1:1) (2:2:2) (3:3:3))
      (IOPATH b y (1:1:1) (2:2:2) (3:3:3) (4:4:4) (5:5:5) (6:6:6))
      (IOPATH c y (1:1:1) (2:2:2) (3:3:3) (4:4:4) (5:5:5) (6:6:6) (7:7:7) (8:8:8) (9:9:9) (10:10:10) (11:11:11) (12:12:12))
      (IOPATH d y (7:7:7))
      (IOPATH e y (1:1:1) (2:2:2) (3:3:3) (4:4:4) (5:5:5))
      (IOPATH f y (1:1:1) () (3:3:3))
      (COND en == 1'b1 (IOPATH a y (4:4:4) (5:5:5)))
      (IOPATH (negedge clk) q (6:6:6) (7:7:7))
      (COND a == 1'b1 && b == 1'b0 (IOPATH (posedge g) y (8:8:8) (9:9:9)))
      (PORT a (21:21:21) (22:22:22) (23:23:23))
      (DEVICE z (19:19:19))
      (DEVICE (20:20:20))))
    (TIMINGCHECK
      (SETUPHOLD d (posedge clk) (1:1:1) (2:2:2))
      (SETUP d (negedge clk) (3:3:3))
      (HOLD d (negedge clk) (4:4:4))
      (RECREM rst (posedge clk) (5:5:5) (6:6:6))
      (RECOVERY rst (negedge clk) (7:7:7))
      (REMOVAL rst (negedge clk) (8:8:8))
      (SKEW a b (9:9:9))
      (BIDIRECTSKEW (posedge a) (posedge b) (10:10:10) (11:11:11))
      (NOCHANGE a (posedge b) (12:12:12) (13:13:13))
      (WIDTH (negedge clk) (14:14:14))
      (PERIOD (posedge clk) (15:15:15))
      (WIDTH clk (16:16:16))
      (SETUP (COND Reset == 1'b1 data) (posedge clk) (17:17:17))
      (HOLD data (COND mode != 1'b0 (posedge clk)) (18:18:18))))
)
