sns next-step fx=one,two,y md=m00,M01,M10,m11 dy=d0,D1 q=Q0,q1,- ai=2,SEVEN,nine as=2,KAY,jay
sns before-delay fx=one,two,y md=m00,M01,M10,m11 dy=d0,D1 q=Q0,q1,- ai=2,SEVEN,nine as=2,KAY,jay
sns after-delay fx=late,two,y md=m00,M01,M10,m11 dy=d0,D1 q=Q0,q1,- ai=2,SEVEN,nine as=2,KAY,jay
