#c root defname=@work.top
#c unit name=work.top:a
#c unit lib=work
#c entity name=top
#c curregion is root=1
#c v range left=7 right=0 up=0 intrange=1
#c v numdims=1
#c color literals=3
#c std_logic literals=9
#c v sigkind=1003 forced=0
#c static v(3)=1003 range=1001 decl undefined=1
#c v oct=262 hex=B2 dec=178
#c raw rc=0 elems=8
#c slice kind=1 bin=1100 hex=C size=4 left=5
#c alias name=hi
#c alias bin=1011 target is slice=1
#c hi(3)=1
#c format int->hex=B2 int->bin=10110010 bin->hex=C hex->int=255
#c real left<0=1 right>0=1 val=1.5
#c tool vhdlversion=2019
#c root numports=0 numgens=0 uninstantiated=0
#c leaf numports=1 numgens=0
#c k deferred=0 implicit=0 dynamic=0
#c v implicit=0 dynamic=0
#c resolved resolved_bit=1 unit_volts=0 anonymous=0
#c quad anonymous=0 base anonymous=1
#c fi openmode=1003
#c drive params=2 s resolved=1 t resolved=0 s dynamic=1
#c volts left=-1 right=2.5 unit_volts left=0 right=1
#c volts range float=1 left=-1 right=2.5
#c iterator type decls=1
#c signature twice=[integer return integer]
#c signature twice=[real return real]
#c signature nop=[]
#c signature drive=[std_ulogic, bit]
#c literal red=[return color]
#c unit physical name set=1
#c decl vhpienumtypedeclk color line=9 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpiconstdeclk k line=10 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisigdeclk v line=11 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisigdeclk c line=12 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisigdeclk r line=13 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpialiasdeclk hi line=14 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpifuncdeclk twice line=16 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpifuncdeclk twice line=20 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpiprocdeclk nop line=24 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpicompdeclk leaf line=27 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpiattrdeclk note line=30 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpiattrspeck note line=31 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpigrouptempdeclk pair line=32 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpigroupdeclk vr line=33 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpifloattypedeclk volts line=34 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisubtypedeclk unit_volts line=35 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisubtypedeclk resolved_bit line=36 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpisubtypedeclk quad line=37 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpifiletypedeclk int_file line=38 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpifiledeclk fi line=39 offset=2 file=foreign_vhpi_model.vhd
#c decl vhpiprocdeclk drive line=40 offset=2 file=foreign_vhpi_model.vhd
#c root kind=vhpirootinstk line=8 offset=0 unit line=8
