#c sized in alpha,beta,gamma
#c sized ret=3 o=out0,out1
#c open d dimensions=1 left=4 right=2 low=2 high=4 size=3
#c open d[2]=two
#c open d[3]=three
#c open d[4]=four
#c open m dimensions=2
#c open m[1][0]=a
#c open m[1][1]=b
#c open m[2][0]=c
#c open m[2][1]=d
#c open ret=7
#c swap in x=x1,x0 y=y1,y0
#c swap x=x1,x0 y=y1,y0
#c fill r=low,high
#c dyn q size=3 left=0 right=2
#c dyn q[0]=p
#c dyn q[1]=q
#c dyn q[2]=r
#c dyn io[0]=i0
#c dyn io[1]=i1
#c dyn o size=2
#c dyn ret=7 io=first,last o=n0,n1
