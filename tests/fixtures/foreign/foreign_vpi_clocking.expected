#c cb type=vpiClockingBlock full=top.cb instance=top event=vpiEventControl condition=-
#c cb condition-op optype=39 operand=clk
#c cb default-input type=vpiDelayControl delay=1
#c cb default-output type=vpiDelayControl delay=2
#c cb default-edges input=none output=none
#c cb.data type=vpiClockingIODecl full=top.cb.data dir=input parent=cb expr=data
#c cb.data input-skew none
#c cb.data output-skew none
#c cb.res type=vpiClockingIODecl full=top.cb.res dir=output parent=cb expr=res
#c cb.res input-skew none
#c cb.res output-skew none
#c cb.ack type=vpiClockingIODecl full=top.cb.ack dir=input parent=cb expr=ack
#c cb.ack input-skew type=vpiDelayControl delay=3
#c cb.ack output-skew none
#c cb.rdy type=vpiClockingIODecl full=top.cb.rdy dir=inout parent=cb expr=rdy
#c cb.rdy input-skew none
#c cb.rdy output-skew none
#c cb2 type=vpiClockingBlock full=top.cb2 instance=top event=vpiEventControl condition=clk
#c cb2 default-input none
#c cb2 default-output none
#c cb2 default-edges input=none output=none
#c cb2.ack2 type=vpiClockingIODecl full=top.cb2.ack2 dir=input parent=cb2 expr=ack2
#c cb2.ack2 input-skew type=vpiDelayControl delay=none
#c cb2.ack2 output-skew none
#c cb2.mon type=vpiClockingIODecl full=top.cb2.mon dir=output parent=cb2 expr=mon
#c cb2.mon input-skew none
#c cb2.mon output-skew type=vpiDelayControl delay=4
#c gck type=vpiClockingBlock full=top.gck instance=top event=vpiEventControl condition=-
#c gck condition-op optype=39 operand=clk
#c gck default-input none
#c gck default-output none
#c gck default-edges input=none output=none
#c clocking blocks=3
#c by name cb2
#c default clocking cb global clocking gck
#c nettype real_t typespec=vpiRealTypespec
#c nettype real_t type=vpiNettypeDecl full=top.real_t with=- alias=-
#c nettype alias_t typespec=vpiRealTypespec
#c nettype alias_t type=vpiNettypeDecl full=top.alias_t with=- alias=real_t
#c nettype pick_t typespec=vpiRealTypespec
#c nettype pick_t type=vpiNettypeDecl full=top.pick_t with=pick alias=-
#c nettype vec_t typespec=vpiLogicTypespec
#c nettype vec_t type=vpiNettypeDecl full=top.vec_t with=- alias=-
#c nettypes=4
#c net top.nv type=vpiNet nettype=14 resolved=14 size=4 decl=vec_t typespec=vpiLogicTypespec
#c net top.ic type=vpiInterconnectNet nettype=16 resolved=1 size=1 decl=- typespec=-
#c net top.icv type=vpiInterconnectNet nettype=16 resolved=1 size=4 decl=- typespec=vpiLogicTypespec
#c net top.ica type=vpiInterconnectArray nettype=16 resolved=1 size=2 decl=- typespec=-
#c net top.ica packed=0
#c net top.ica left=1 right=0
#c element top.ica[0] type=vpiInterconnectNet size=4
#c element top.ica[1] type=vpiInterconnectNet size=4
#c net top.icq type=vpiInterconnectNet nettype=16 resolved=1 size=4 decl=- typespec=vpiStructTypespec
#c member top.icq.hi type=vpiInterconnectNet size=2
#c member top.icq.lo type=vpiInterconnectNet size=2
#c net top.icd type=vpiInterconnectNet nettype=16 resolved=1 size=4 decl=- typespec=vpiPackedArrayTypespec
#c element top.icd[1] type=vpiInterconnectNet size=2
#c element top.icd[0] type=vpiInterconnectNet size=2
#c gcb type=vpiClockingBlock full=top.g.gcb instance=top event=vpiEventControl condition=-
#c gcb condition-op optype=39 operand=clk
#c gcb default-input none
#c gcb default-output none
#c gcb default-edges input=none output=none
#c gcb.gd type=vpiClockingIODecl full=top.g.gcb.gd dir=input parent=gcb expr=gd
#c gcb.gd input-skew type=vpiDelayControl delay=1
#c gcb.gd output-skew none
#c gcb.gq type=vpiClockingIODecl full=top.g.gcb.gq dir=output parent=gcb expr=gq
#c gcb.gq input-skew none
#c gcb.gq output-skew type=vpiDelayControl delay=2
#c parent g
#c top.g clocking blocks=1
#c lcb type=vpiClockingBlock full=top.gl[1].lcb instance=top event=vpiEventControl condition=-
#c lcb condition-op optype=40 operand=clk
