(DELAYFILE
  (SDFVERSION "4.0")
  (DESIGN "top")
  (DIVIDER .)
  (TIMESCALE 1 ns)
  (CELL (CELLTYPE "top") (INSTANCE top)
    (DELAY (ABSOLUTE
      (INTERCONNECT u0.z u1.a (2) (3)))))
  (CELL (CELLTYPE "drv") (INSTANCE top.u1)
    (DELAY (ABSOLUTE
      (PORT a (4))))))
