#c scope [top.lbl] name [lbl] type 15
#c   scope [top.lbl.lb] name [lb] type 33
#c scope [top.fl] name [fl] type 675
#c   scope [top.fl.blk] name [blk] type 33
#c scope [top.m2] name [m2] type 675
#c   scope [top.m2.b2] name [b2] type 33
#c scope [top.st] name [st] type 33
#c scope [-] name [-] type 15
#c   scope [-] name [inner] type 33
#c scope [top.g] name [g] type 134
#c   scope [-] name [-] type 4
